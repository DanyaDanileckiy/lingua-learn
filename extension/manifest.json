{
 "manifest_version": 3,
 "name": "Lingua — двойные субтитры",
 "version": "0.3.0",
 "description": "Двойные субтитры на YouTube и сохранение слов",
 "permissions": [
  "storage"
 ],
 "host_permissions": [
  "https://www.youtube.com/*",
  "https://translate.googleapis.com/*"
 ],
 "background": {
  "service_worker": "background.js"
 },
 "content_scripts": [
  {
   "matches": [
    "https://www.youtube.com/*"
   ],
   "js": [
    "content.js"
   ],
   "css": [
    "content.css"
   ],
   "run_at": "document_idle"
  },
  {
   "matches": [
    "https://danyadanileckiy.github.io/lingua-learn/*",
    "http://localhost/*"
   ],
   "js": [
    "sync.js"
   ],
   "run_at": "document_idle"
  }
 ],
 "web_accessible_resources": [
  {
   "resources": [
    "inject.js"
   ],
   "matches": [
    "https://www.youtube.com/*"
   ]
  }
 ],
 "action": {
  "default_popup": "popup.html"
 },
 "options_page": "options.html"
}